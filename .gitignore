# =============================================================================
#  忽略清单
# =============================================================================
#  提交的东西 = 源代码 + 关卡配置（game.toml / balls.toml）+ 球库 + 打包配方
#  不提交的   = 虚拟环境、打包产物、缓存、IDE 配置
#
#  注意：ballgame.spec 是**要提交**的（它是打包配方，里面写了把哪两个 toml
#  打进去）。别人 clone 下来直接 pyinstaller ballgame.spec 就能打出一样的包。
# =============================================================================


# ── 打包产物 ──────────────────────────────────────────────────────────────
# PyInstaller 的输出目录：dist/ 是最终成品（几百 MB），build/ 是中间产物
dist/
build/
*.manifest


# ── 分发给别人的压缩包 ────────────────────────────────────────────────────
# 把 dist/ballgame/ 压成的 zip，别提交进来
*.zip
*.7z
*.rar
*.tar.gz


# ── Python 缓存 ───────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
build/lib/


# ── 虚拟环境 ──────────────────────────────────────────────────────────────
.venv/
venv/
env/
ENV/
virtualenv/


# ── 测试 / 检查工具的缓存 ─────────────────────────────────────────────────
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/


# ── 编辑器 / IDE ──────────────────────────────────────────────────────────
.idea/
.vscode/
*.swp
*.swo
*~


# ── 操作系统 ──────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini


# ── 密钥 / 本地配置 ───────────────────────────────────────────────────────
.env
.env.*
!.env.example


# ── 日志 / 临时调试文件 ───────────────────────────────────────────────────
*.log
_*.png
